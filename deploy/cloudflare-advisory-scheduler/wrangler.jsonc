{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trading-signals-scheduler",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-22",
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "secrets": {
    "required": ["GITHUB_TOKEN"]
  }
}
